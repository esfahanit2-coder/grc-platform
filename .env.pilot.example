APP_ENV=production
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=grc.example.internal
CORS_ALLOWED_ORIGINS=https://grc.example.internal
CSRF_TRUSTED_ORIGINS=https://grc.example.internal
POSTGRES_DB=grc
POSTGRES_USER=grc
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Point to an approved S3-compatible object store for pilot evidence files.
S3_ENDPOINT_URL=https://s3.example.internal
S3_REGION=us-east-1
S3_BUCKET=grc-evidence
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_USE_SSL=1
MFA_ENCRYPTION_KEY=replace-with-valid-fernet-key
MFA_ISSUER=GRC Platform
AUTH_COOKIE_MODE=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=0
AUTH_COOKIE_SAMESITE=Strict
AI_RAG_MODE=hybrid
AI_DEFAULT_CLASSIFICATION=internal
CONNECTOR_HTTP_TIMEOUT=30
CONNECTOR_MAX_RESPONSE_BYTES=5242880
# Connector secrets referenced by ConnectorConfig.secret_env_var / username_env_var
FORTIGATE_API_TOKEN=
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
VEEAM_USERNAME=
VEEAM_PASSWORD=
AD_BIND_USERNAME=
AD_BIND_PASSWORD=
