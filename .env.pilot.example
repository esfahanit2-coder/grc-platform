APP_ENV=production
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=grc.example.internal
CORS_ALLOWED_ORIGINS=https://grc.example.internal
CSRF_TRUSTED_ORIGINS=https://grc.example.internal

POSTGRES_DB=grc
POSTGRES_USER=grc
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Shared production cache for login/MFA/refresh throttles. Keep it reachable only
# by trusted application services; a dedicated Redis DB/instance may be used.
AUTH_THROTTLE_REDIS_URL=redis://redis:6379/0
AUTH_LOGIN_RATE=10/min
AUTH_MFA_RATE=12/min
AUTH_REFRESH_RATE=30/min

# Bundled pilot S3-compatible object storage (SeaweedFS in docker-compose.pilot.yml).
# For an approved external S3-compatible service, replace the endpoint/credentials;
# application code remains storage-provider agnostic.
S3_ENDPOINT_URL=http://objectstore:8333
S3_REGION=us-east-1
S3_BUCKET=grc-evidence
S3_ACCESS_KEY=replace-with-strong-objectstore-access-key
S3_SECRET_KEY=replace-with-strong-objectstore-secret-key
S3_USE_SSL=0

# Evidence files enter malware_scan_status=pending. Production download is
# fail-closed until an authorized scanner/integration sets the status to clean.
EVIDENCE_MAX_FILE_SIZE=26214400
EVIDENCE_REQUIRE_CLEAN_DOWNLOAD=1

MFA_ENCRYPTION_KEY=replace-with-valid-fernet-key
MFA_ISSUER=GRC Platform

AUTH_COOKIE_MODE=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=0
AUTH_COOKIE_SAMESITE=Strict

# AI can be disabled globally without changing domain code.
AI_ENABLED=1
AI_RAG_MODE=hybrid
AI_DEFAULT_CLASSIFICATION=internal
# The optional compose profile `local-ai` exposes Ollama internally at:
# http://ollama:11434
# Create a tenant AIProviderConfig of type `ollama` and point it there.
# Model files must be preloaded/imported for an air-gapped deployment; the stack
# deliberately does not download models on startup.

CONNECTOR_HTTP_TIMEOUT=30
CONNECTOR_MAX_RESPONSE_BYTES=5242880

# Connector secrets referenced by ConnectorConfig.secret_env_var / username_env_var.
FORTIGATE_API_TOKEN=
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
VEEAM_USERNAME=
VEEAM_PASSWORD=
AD_BIND_USERNAME=
AD_BIND_PASSWORD=

# TLS override (`docker-compose.pilot.tls.yml`). Keep private keys outside Git.
TLS_CERT_PATH=./runtime/tls/server.crt
TLS_KEY_PATH=./runtime/tls/server.key
